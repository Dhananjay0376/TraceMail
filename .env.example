# TraceMail Environment Configuration

# Hugging Face Model Repository (optional, defaults to local baseline or local distilbert)
HF_MODEL_NAME=Dhananjay-N/tracemail-distilbert-phishing-v2

# IP Geolocation API Token (optional, free-tier ipinfo.io or ip-api.com fallback)
